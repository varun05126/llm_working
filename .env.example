# SkillHer Environment Configuration Template
# NOTE: Use placeholders only. Never commit real credentials to this file.

# Django Security
SECRET_KEY=your_django_secret_key_here
DEBUG=True

# Groq LLM API (Inference Engine)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional External API Keys (Leave blank to use deterministic search URLs)
YOUTUBE_API_KEY=your_youtube_api_key_here
GITHUB_TOKEN=your_github_personal_access_token_here

# Optional Hosted Database (PostgreSQL URL e.g. Neon, Supabase)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional Email SMTP Delivery
CONTACT_EMAIL=your_contact_email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here